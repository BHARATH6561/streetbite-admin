generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Vendor {
  id                  String   @id @default(cuid())
  hotel               String
  phone               String
  owner               String
  aadhaar             String?
  aadhaarFile         String?
  pan                 String?
  panFile             String?
  gst                 String?
  gstFile             String?
  fssai               String?
  fssaiFile           String?
  address             String?
  city                String?
  state               String?
  pin                 String?
  boardFile           String?
  bankName            String?
  accType             String?
  accNo               String?
  ifsc                String?
  branch              String?
  status              String   @default("pending")
  rating              Float    @default(0)
  totalOrders         Int      @default(0)
  cancelledHotelDelay Int      @default(0)
  totalRevenue        Float    @default(0)
  commission          Float    @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  menuItems           MenuItem[]
  orders              Order[]
  paymentRequests     VendorPayment[]
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  foodType    String   @default("VEG")
  price       Float    @default(0)
  photoUrl    String?
  status      String   @default("pending")
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  vendorId    String
  vendorName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rider {
  id              String   @id @default(cuid())
  name            String
  aadhaar         String?
  aadhaarFile     String?
  pan             String?
  panFile         String?
  photoFile       String?
  vehicle         String?
  vehicleFile     String?
  rcFile          String?
  dl              String?
  dlFile          String?
  city            String?
  state           String?
  pincode         String?
  bankName        String?
  accNo           String?
  ifsc            String?
  branch          String?
  status          String   @default("pending")
  rating          Float    @default(0)
  totalDeliveries Int      @default(0)
  cancelledDelay  Int      @default(0)
  totalEarnings   Float    @default(0)
  deliveryFee     Float    @default(30)
  handicap        String   @default("NO")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orders          Order[]
}

model Order {
  id            String   @id @default(cuid())
  status        String   @default("live")
  delayed       Boolean  @default(false)
  cancelledBy   String?
  customerName  String?
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  vendorId      String
  vendorName    String?
  vendorOwner   String?
  vendorPhone   String?
  rider         Rider?   @relation(fields: [riderId], references: [id])
  riderId       String?
  riderName     String?
  riderPhone    String?
  items         String
  itemsFoodType String?
  orderTime     String?
  orderDate     String?
  amount        Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  email       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Complaint {
  id          String   @id @default(cuid())
  orderId     String?
  subject     String
  description String
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationLog {
  id        String   @id @default(cuid())
  type      String
  message   String
  recipient String?
  status    String   @default("sent")
  createdAt DateTime @default(now())
}

model VendorPayment {
  id          String   @id @default(cuid())
  vendorId    String
  vendorName  String?
  amount      Float
  status      String   @default("pending")
  requestedAt DateTime @default(now())
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
}
